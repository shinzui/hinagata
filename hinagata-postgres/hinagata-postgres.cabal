cabal-version: 3.12
name: hinagata-postgres
version: 0.1.0.0
synopsis: Transactional PostgreSQL execution for Hinagata fixture plans
description: Private native libpq sessions for atomic SQL and CSV fixtures.
category: Testing
license: BSD-3-Clause
license-file: LICENSE
data-files: sql/catalog-v1.sql
build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options: -Wall

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Hinagata.Postgres.Baseline
    Hinagata.Postgres.Error
    Hinagata.Postgres.Lease
    Hinagata.Postgres.Load
    Hinagata.Postgres.Ownership
    Hinagata.Postgres.Session

  other-modules:
    Hinagata.Postgres.Internal.Access
    Hinagata.Postgres.Internal.BaselineRef
    Hinagata.Postgres.Internal.Copy
    Hinagata.Postgres.Internal.Libpq
    Hinagata.Postgres.Internal.Load
    Hinagata.Postgres.Internal.Sql
    Paths_hinagata_postgres

  build-depends:
    base >=4.21 && <5,
    bytestring >=0.12 && <0.14,
    cryptohash-sha256 >=0.11.102.1 && <0.12,
    directory >=1.3 && <1.5,
    filepath >=1.5 && <1.7,
    hinagata-core,
    postgresql-libpq >=0.11.0.0 && <0.12,
    text >=2.1 && <2.3,
    time >=1.14 && <1.16,
    unix >=2.8 && <2.10,

test-suite hinagata-postgres-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.21 && <5,
    bytestring >=0.12 && <0.14,
    directory >=1.3 && <1.5,
    filepath >=1.5 && <1.7,
    hinagata-core,
    hinagata-postgres,
    postgresql-libpq >=0.11.0.0 && <0.12,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.3,

benchmark hinagata-postgres-direct-load
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Main.hs
  ghc-options: -rtsopts
  build-depends:
    base >=4.21 && <5,
    bytestring >=0.12 && <0.14,
    directory >=1.3 && <1.5,
    filepath >=1.5 && <1.7,
    hinagata-core,
    hinagata-postgres,
    postgresql-libpq >=0.11.0.0 && <0.12,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.3,
