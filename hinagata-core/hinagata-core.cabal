cabal-version: 3.12
name: hinagata-core
version: 0.1.0.0
synopsis: Pure fixture plans and configuration for Hinagata
description: Deterministic fixture planning for PostgreSQL test databases.
category: Testing
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options: -Wall

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Hinagata.Connection
    Hinagata.Fixture.Graph
    Hinagata.Fixture.Types
    Hinagata.Prelude
    Hinagata.Types

  build-depends:
    aeson >=2.2 && <2.4,
    base >=4.21 && <5,
    bytestring >=0.12 && <0.14,
    containers >=0.7 && <0.9,
    filepath >=1.5 && <1.7,
    lens >=5.3 && <5.4,
    text >=2.1 && <2.3,
    time >=1.14 && <1.16,

test-suite hinagata-core-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.21 && <5,
    hinagata-core,
    text >=2.1 && <2.3,
